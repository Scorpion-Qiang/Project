<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>org.example</groupId>
    <artifactId>online_OJ</artifactId>
    <version>1.0-SNAPSHOT</version>
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <source>8</source>
                    <target>8</target>
                </configuration>
            </plugin>

            <!-- 在将项目进行打包时，需要将lib中的jar包也打包进去-->
<!--            <plugin>-->
<!--                <groupId>org.apache.maven.plugins</groupId>-->
<!--                <artifactId>maven-compiler-plugin</artifactId>-->
<!--                <version>3.6.0</version>-->
<!--                <configuration>-->
<!--                    <source>1.8</source>-->
<!--                    <target>1.8</target>-->
<!--                    <encoding>UTF-8</encoding>-->
<!--                    <compilerArguments>-->
<!--                        <extdirs>${project.basedir}/lib</extdirs>-->
<!--                    </compilerArguments>-->
<!--                </configuration>-->
<!--            </plugin>-->

        </plugins>

        <finalName>OnlineJudge</finalName>

        <!--maven中央仓库中没有的第三方库，我们将依赖的jar包放在 lib 目录中了，在打包时，也要一并将它们也打包，否则某些依赖它们的类没法用-->
        <resources>
            <resource>
                <!--指定 jar 包存在的路径（从哪里来）-->
                <directory>lib</directory>
                <!--jar 包默认放在 WEB—INF/lib中（在 云服务器服务器上）-->
            </resource>
        </resources>


    </build>

    <dependencies>
        <!--mysql第三方库-->
        <dependency>
            <groupId>mysql</groupId>
            <artifactId>mysql-connector-java</artifactId>
            <version>5.1.49</version>
        </dependency>

        <!--servlet第三方库-->
        <dependency>
            <groupId>javax.servlet</groupId>
            <artifactId>javax.servlet-api</artifactId>
            <version>3.1.0</version>
            <scope>provided</scope>
        </dependency>

        <!--Jackson第三方库，解析JSON语句-->
        <!-- https://mvnrepository.com/artifact/com.fasterxml.jackson.core/jackson-databind -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>2.13.3</version>
        </dependency>

        <!-- https://mvnrepository.com/artifact/org.ansj/ansj_seg -->
        <!-- ansj 分词的第三方库 -->
        <dependency>
            <groupId>org.ansj</groupId>
            <artifactId>ansj_seg</artifactId>
            <version>5.1.6</version>
        </dependency>


        <!-- 注意这里的坐标和版本号随意，但是scope要写system，然后systemPath就是上面jar包的路径-->
<!--        <dependency>-->
<!--            <groupId>ValidateCode</groupId>-->
<!--            <artifactId>ValidateCode</artifactId>-->
<!--            <version>1.0</version>-->
<!--            <scope>system</scope>-->
<!--            <systemPath>${basedir}/lib/ValidateCode.jar</systemPath>-->
<!--        </dependency>-->

    </dependencies>

    <packaging>war</packaging>   <!-- 设置包的类型 .war -->

</project>